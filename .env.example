# ─────────────────────────────────────────────────────────────
# 九爺，我想給您養老 — 環境變數
#
# 完全不設定也能跑：系統會自動退回「記憶體模式」，
# 適合開發與試玩，但伺服器一重啟資料就沒了。
# 要正式用 Google Sheet 當資料庫，把下面填好即可。
# ─────────────────────────────────────────────────────────────

# 你的試算表 ID。網址中間那一段：
# https://docs.google.com/spreadsheets/d/【這一段就是 ID】/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# ── 憑證：以下三種擇一 ──

# 方式 A（推薦，最好貼在 Vercel/Render 這類平台）：
# 把服務帳號 JSON 整包貼進來，或先轉成 base64 再貼（兩種都吃）
#   base64 -w0 service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# 方式 B：拆成兩個變數。私鑰裡的換行請寫成 \n
# GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@yyy.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# 方式 C：本機開發，直接指向 JSON 檔案路徑
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ── 選用 ──

# 場次快取存活秒數（毫秒）。調大 = 更省 Sheets API 配額，
# 但主持人直接在試算表上手改數字後，反映到畫面會慢一些。預設 15000。
# SESSION_CACHE_TTL_MS=15000
